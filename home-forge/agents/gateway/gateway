#!/usr/bin/env bash
# Tells a human that a run wants looking at, once per pause, failure or end.
# Nothing listens for an answer: a gate is answered on the machine, from
# `agent menu`, which calls `gateway reply`.
#
# Knows nothing about any channel: a channel is a directory under channels/
# holding one executable.
#   notify <request.json>  delivers the message
#
# Everything an answer cannot be trusted with — that the run still waits on a
# gate, that the choice is one the gate offered — is checked here.
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# config.env holds this machine's configuration. What is already in the
# environment wins, so a single pass can be pointed elsewhere for a test —
# and reading the file has to happen before any default is applied, or the
# file is read too late to matter.
if [ -f "$HERE/config.env" ]; then
  while IFS='=' read -r key value; do
    case "$key" in ''|'#'*) continue ;; esac
    value=${value%%#*}
    value=${value%"${value##*[![:space:]]}"}
    [ -n "${!key:-}" ] || export "$key=$value"
  done < "$HERE/config.env"
fi

STATE=${AGENT_GATEWAY_STATE:-$HOME/.local/state/agent-gateway}
PROJECTS=${AGENT_PROJECTS:-$HOME/projects}
CHANNEL=${AGENT_GATEWAY_CHANNEL:-file}
TICK=${AGENT_GATEWAY_TICK:-60}
# A written answer is a few sentences. Past this it is a paste by mistake.
MAX_ANSWER=${AGENT_MAX_ANSWER:-4000}

mkdir -p "$STATE/done"

usage() {
  cat >&2 <<'USAGE'
usage:
  gateway scan     one pass: say once what is waiting, failed or finished
  gateway reply <project>/<branch> <run_id> <answer>
                   answer the gate a run is paused on
  gateway say <title> [line]
                   say something no run asked for, through the same channel
USAGE
  exit 1
}

channel() {
  local verb=$1; shift
  local exe="$HERE/channels/$CHANNEL/$verb"
  [ -x "$exe" ] || { echo "channel $CHANNEL has no $verb" >&2; return 1; }
  "$exe" "$@"
}

# A run is identified by where it lives, which run it is, which step is
# waiting, and when the engine dated that pause. The instant matters: a loop
# can bring the same run back to the same gate, and each pause is its own
# message.
request_id() { printf '%s__%s__%s__%s' "${1//\//_}" "$2" "$3" "${4//[^0-9]/}"; }

# The gate's step result says what was asked; only the workflow says which
# input carries the answer, and where a written one is left.
gate_field() {
  local wf=$1 step=$2 key=$3
  awk -v step="$step" -v key="$key" '
    $0 ~ "^[[:space:]]*-[[:space:]]*id:[[:space:]]*" step "[[:space:]]*$" { inside = 1; next }
    inside && /^[[:space:]]*-[[:space:]]*id:/ { exit }
    inside && $0 ~ "^[[:space:]]*" key ":" {
      sub("^[[:space:]]*" key ":[[:space:]]*", ""); print; exit }
  ' "$wf"
}

# Where a run stands, as one JSON object; nothing while it is still working.
# Read from the run itself every time, so a reply never acts on a stale copy.
request_of() {
  local run_dir=$1 target=$2
  local state_file="$run_dir/state.json" wf="$run_dir/workflow.yml"
  local status step input="" answer_file=""
  status=$(jq -r '.status' "$state_file")
  step=$(jq -r '.current_step_id // "-"' "$state_file")
  case "$status" in paused|failed|completed) ;; *) return 0 ;; esac
  if [ "$status" = paused ]; then
    input=$(gate_field "$wf" "$step" verdict_input)
    answer_file=$(gate_field "$wf" "$step" answer_file)
  fi
  jq --arg target "$target" --arg tree "$PROJECTS/$target" \
     --arg input "$input" --arg answer_file "$answer_file" '
    .current_step_id as $step
    | {kind: ({paused: "gate", failed: "failure", completed: "done"}[.status]),
       target: $target, run_id, step: ($step // "-"), tree: $tree,
       input: $input, answer_file: $answer_file, paused_at: .updated_at,
       title: (if .status == "paused"
               then (.step_results[$step].output.message // "?") | split("\n")[0]
               elif .status == "failed" then "Run en échec"
               else "Run terminé" end),
       options: (.step_results[$step].output.options // []),
       # The push leaves the pull request on stdout; nothing else names it.
       url: ((.step_results["do-open-pr"].output.stdout // "")
             | [scan("https://\\S+")] | last // "")}' "$state_file"
}

announce() {
  local run_dir=$1 target=$2
  local state_file="$run_dir/state.json" req
  req=$(request_of "$run_dir" "$target")
  [ -n "$req" ] || return 0
  # A rewind writes "failed" a moment before the engine restarts, so a failure
  # is only worth saying once it has survived a tick.
  [ "$(jq -r .kind <<< "$req")" = failure ] \
    && [ $(( $(date +%s) - $(stat -c %Y "$state_file") )) -lt "$TICK" ] && return 0

  local id
  id=$(request_id "$target" "$(jq -r .run_id <<< "$req")" \
                  "$(jq -r .step <<< "$req")" "$(jq -r .paused_at <<< "$req")")
  [ -e "$STATE/done/$id.json" ] && return 0

  jq --arg id "$id" '. + {id: $id}' <<< "$req" > "$STATE/done/$id.json"
  channel notify "$STATE/done/$id.json" >/dev/null \
    || { rm -f "$STATE/done/$id.json"; echo "notify failed for $id" >&2; return 0; }
  echo "notified  $id"
}

# Everything that makes a reply an answer happens here, whoever typed it.
apply_answer() {
  local req=$1 answer=$2
  local options choice input target run tree
  target=$(jq -r '.target' "$req"); run=$(jq -r '.run_id' "$req")
  tree=$(jq -r '.tree' "$req")

  options=$(jq -r '.options[]' "$req")
  choice=$(printf %s "$answer" | tr -d '[:space:]')
  if ! grep -qxF -- "$choice" <<< "$options"; then
    # Not one of the options, so it is prose — accepted only by a gate that
    # asked for some. It travels as a file and never as an argument.
    local file dir
    file=$(jq -r '.answer_file // empty' "$req")
    [ -n "$file" ] || {
      echo "refused   '$choice' is not one of: $(tr '\n' ' ' <<< "$options")" >&2; return 1; }
    [ "${#answer}" -le "$MAX_ANSWER" ] || {
      echo "refused   the answer is longer than $MAX_ANSWER characters" >&2; return 1; }
    dir="$tree/.specify/state/$run"
    mkdir -p "$dir"
    printf '%s\n' "$answer" > "$dir/$file"
    # The gate still needs one of its own words, and the first is the one that
    # carries on; a gate offering prose never has a reject in that position.
    choice=$(head -1 <<< "$options")
    echo "written   $dir/$file"
  fi

  input=$(jq -r '.input' "$req")
  [ -n "$input" ] || { echo "refused   the gate declares no verdict_input" >&2; return 1; }

  agent answer "$target" "$run" "$input=$choice" >/dev/null
  echo "answered  $target $run  $input=$choice"
}

reply() {
  local target=${1:?missing project/branch} run=${2:?missing run_id}
  shift 2
  local answer="$*"
  [ -n "$answer" ] || { echo "nothing to reply" >&2; exit 1; }
  local run_dir="$PROJECTS/$target/.specify/workflows/runs/$run"
  [ -f "$run_dir/state.json" ] || { echo "no such run: $target $run" >&2; exit 1; }
  local req; req=$(mktemp)
  request_of "$run_dir" "$target" > "$req"
  [ "$(jq -r '.kind // empty' "$req" 2>/dev/null)" = gate ] || {
    rm -f "$req"; echo "$target $run is not paused on a gate" >&2; exit 1; }
  apply_answer "$req" "$answer" || { rm -f "$req"; exit 1; }
  rm -f "$req"
}

say() {
  local title=${1:?missing title} line=${2:-} req
  req=$(mktemp)
  jq -n --arg title "$title" --arg next "$line" \
    '{kind: "info", title: $title, next: $next, target: "", step: "", url: ""}' > "$req"
  channel notify "$req" || { rm -f "$req"; exit 1; }
  rm -f "$req"
}

scan() {
  local tree target run_dir
  for tree in "$PROJECTS"/*/*/; do
    [ -d "$tree/.specify/workflows/runs" ] || continue
    target="$(basename "$(dirname "$tree")")/$(basename "$tree")"
    for run_dir in "$tree"/.specify/workflows/runs/*/; do
      [ -f "$run_dir/state.json" ] || continue
      announce "${run_dir%/}" "$target" \
        || echo "announce failed for $target $(basename "$run_dir")" >&2
    done
  done
  # The only sweep of every run on this machine, so it carries the bookkeeping
  # too. A failure here must not cost the messages their pass.
  record scan || echo "record scan failed" >&2
}

case ${1:-} in
  scan)   scan ;;
  reply)  shift; reply "$@" ;;
  say)    shift; say "$@" ;;
  *)      usage ;;
esac
