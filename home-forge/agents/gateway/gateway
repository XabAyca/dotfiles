#!/usr/bin/env bash
# Carries a question from a paused run to a human, and the answer back.
#
# Knows nothing about any channel: a channel is a directory under channels/
# holding two executables.
#   notify <request.json>  delivers the question, prints a handle on stdout
#   poll   <request.json>  prints the answer, or nothing when none has come
#
# Everything a channel cannot be trusted with — that the run exists, that the
# choice is one the gate offered — is checked here, after the channel has
# spoken.
set -euo pipefail

HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
# config.env holds this machine's configuration. What is already in the
# environment wins, so a single pass can be pointed elsewhere for a test —
# and reading the file has to happen before any default is applied, or the
# file is read too late to matter.
if [ -f "$HERE/config.env" ]; then
  while IFS='=' read -r key value; do
    case "$key" in ''|'#'*) continue ;; esac
    value=${value%%#*}
    value=${value%"${value##*[![:space:]]}"}
    [ -n "${!key:-}" ] || export "$key=$value"
  done < "$HERE/config.env"
fi

STATE=${AGENT_GATEWAY_STATE:-$HOME/.local/state/agent-gateway}
PROJECTS=${AGENT_PROJECTS:-$HOME/projects}
CHANNEL=${AGENT_GATEWAY_CHANNEL:-file}
TICK=${AGENT_GATEWAY_TICK:-60}
# A written answer is a few sentences. Past this it is a paste by mistake.
MAX_ANSWER=${AGENT_MAX_ANSWER:-4000}

mkdir -p "$STATE/requests" "$STATE/done"

usage() {
  cat >&2 <<'USAGE'
usage:
  gateway scan     one pass: announce what is waiting, apply what has answered
  gateway run      the same, every tick, until stopped
  gateway status   what is outstanding
USAGE
  exit 1
}

channel() {
  local verb=$1; shift
  local exe="$HERE/channels/$CHANNEL/$verb"
  [ -x "$exe" ] || { echo "channel $CHANNEL has no $verb" >&2; return 1; }
  "$exe" "$@"
}

# A run is identified by where it lives, which run it is, which step is
# waiting, and when the engine dated that pause. The instant matters: a loop
# can bring the same run back to the same gate, and each pause is its own
# question.
request_id() { printf '%s__%s__%s__%s' "${1//\//_}" "$2" "$3" "${4//[^0-9]/}"; }

# The gate's step result says what was asked; only the workflow says which
# input carries the answer, and where a written one is left.
gate_field() {
  local wf=$1 step=$2 key=$3
  awk -v step="$step" -v key="$key" '
    $0 ~ "^[[:space:]]*-[[:space:]]*id:[[:space:]]*" step "[[:space:]]*$" { inside = 1; next }
    inside && /^[[:space:]]*-[[:space:]]*id:/ { exit }
    inside && $0 ~ "^[[:space:]]*" key ":" {
      sub("^[[:space:]]*" key ":[[:space:]]*", ""); print; exit }
  ' "$wf"
}

announce() {
  local run_dir=$1 target=$2 project=$3
  local state_file="$run_dir/state.json" wf="$run_dir/workflow.yml"
  local run_id status step paused_at
  run_id=$(jq -r '.run_id' "$state_file")
  status=$(jq -r '.status' "$state_file")
  step=$(jq -r '.current_step_id // "-"' "$state_file")
  paused_at=$(jq -r '.updated_at' "$state_file")

  case "$status" in paused|failed) ;; *) return 0 ;; esac
  # A rewind writes "failed" a moment before the engine restarts, so a failure
  # is only worth announcing once it has survived a tick.
  [ "$status" = failed ] \
    && [ $(( $(date +%s) - $(stat -c %Y "$state_file") )) -lt "$TICK" ] && return 0

  local id; id=$(request_id "$target" "$run_id" "$step" "$paused_at")
  [ -e "$STATE/requests/$id.json" ] && return 0
  [ -e "$STATE/done/$id.json" ] && return 0

  local tree="$PROJECTS/$target" input="" answer_file="" req
  req=$(mktemp)
  if [ "$status" = paused ]; then
    input=$(gate_field "$wf" "$step" verdict_input)
    answer_file=$(gate_field "$wf" "$step" answer_file)
    jq -n --arg id "$id" --arg target "$target" --arg project "$project" \
          --arg run "$run_id" --arg step "$step" --arg input "$input" \
          --arg answer_file "$answer_file" \
          --arg tree "$tree" --slurpfile s "$state_file" \
      '{id: $id, kind: "gate", target: $target, project: $project,
        run_id: $run, step: $step, input: $input, tree: $tree,
        answer_file: $answer_file,
        question: ($s[0].step_results[$step].output.message // "?"),
        options: ($s[0].step_results[$step].output.options // []),
        attachment: ($s[0].step_results[$step].output.show_file // null)}' > "$req"
  else
    jq -n --arg id "$id" --arg target "$target" --arg project "$project" \
          --arg run "$run_id" --arg step "$step" --arg tree "$tree" \
          --slurpfile s "$state_file" \
      '{id: $id, kind: "failure", target: $target, project: $project,
        run_id: $run, step: $step, input: "", tree: $tree, answer_file: "",
        question: ("Run en échec\n\nLe run s'\''est arrêté à l'\''étape `" + $step + "` :\n\n> "
                   + ($s[0].error // "aucune raison enregistrée")),
        options: [], attachment: null}' > "$req"
  fi

  local handle
  handle=$(channel notify "$req") || { rm -f "$req"; echo "notify failed for $id" >&2; return 0; }
  jq --arg h "$handle" '. + {handle: $h}' "$req" > "$STATE/requests/$id.json"
  rm -f "$req"
  echo "asked     $id"
}

apply() {
  local req=$1
  local id kind options answer choice input target run tree step
  id=$(jq -r '.id' "$req"); kind=$(jq -r '.kind' "$req")

  # A failure has nothing to answer: it was said once, and that is all.
  [ "$kind" = failure ] && { mv "$req" "$STATE/done/"; return 0; }

  answer=$(channel poll "$req" || true)
  [ -n "$answer" ] || return 0

  target=$(jq -r '.target' "$req"); run=$(jq -r '.run_id' "$req")
  tree=$(jq -r '.tree' "$req"); step=$(jq -r '.step' "$req")
  # The run must still be waiting on this very step. Checking only that it is
  # paused would let a stale answer be applied to whatever gate came next.
  local live
  live=$(jq -r '.status + " " + (.current_step_id // "-")' \
         "$tree/.specify/workflows/runs/$run/state.json")
  [ "$live" = "paused $step" ] || {
    echo "refused   $id: the run is now '$live', not paused on $step" >&2
    mv "$req" "$STATE/done/"; return 0; }

  options=$(jq -r '.options[]' "$req")
  choice=$(printf %s "$answer" | tr -d '[:space:]')
  if ! grep -qxF -- "$choice" <<< "$options"; then
    # Not one of the options, so it is prose — accepted only by a gate that
    # asked for some. It travels as a file and never as an argument.
    local file dir
    file=$(jq -r '.answer_file // empty' "$req")
    [ -n "$file" ] || {
      echo "refused   $id: '$choice' is not one of the offered options" >&2; return 0; }
    [ "${#answer}" -le "$MAX_ANSWER" ] || {
      echo "refused   $id: the answer is longer than $MAX_ANSWER characters" >&2; return 0; }
    dir="$tree/.specify/state/$run"
    mkdir -p "$dir"
    printf '%s\n' "$answer" > "$dir/$file"
    # The gate still needs one of its own words, and the first is the one that
    # carries on; a gate offering prose never has a reject in that position.
    choice=$(head -1 <<< "$options")
    echo "written   $id  $dir/$file"
  fi

  input=$(jq -r '.input' "$req")
  [ -n "$input" ] || { echo "refused   $id: the gate declares no verdict_input" >&2; return 0; }

  agent answer "$target" "$run" "$input=$choice" >/dev/null
  mv "$req" "$STATE/done/"
  echo "answered  $id  $input=$choice"
}

scan() {
  local tree project target
  for tree in "$PROJECTS"/*/*/; do
    [ -d "$tree/.specify/workflows/runs" ] || continue
    project=$(basename "$(dirname "$tree")")
    target="$project/$(basename "$tree")"
    local run_dir
    for run_dir in "$tree"/.specify/workflows/runs/*/; do
      [ -f "$run_dir/state.json" ] || continue
      announce "${run_dir%/}" "$target" "$project" \
        || echo "announce failed for $target $(basename "$run_dir")" >&2
    done
  done
  local req
  for req in "$STATE/requests"/*.json; do
    [ -f "$req" ] || continue
    apply "$req" || echo "apply failed for $(basename "$req" .json)" >&2
  done
  # The only sweep of every run on this machine, so it carries the bookkeeping
  # too. A failure here must not cost the questions their pass.
  record scan || echo "record scan failed" >&2
}

status() {
  local req
  for req in "$STATE/requests"/*.json; do
    [ -f "$req" ] || { echo "nothing outstanding"; return 0; }
    jq -r '"\(.id)  \(.kind)  \(.options | join("/"))"' "$req"
  done
}

case ${1:-} in
  scan)   scan ;;
  run)    while :; do scan; sleep "$TICK"; done ;;
  status) status ;;
  *)      usage ;;
esac
