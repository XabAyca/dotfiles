# Copy to config.env — that file is not versioned, it names a workspace.
AGENT_GATEWAY_CHANNEL=file        # file | slack
AGENT_GATEWAY_TICK=60

# slack only
SLACK_BOT_TOKEN=xoxb-...          # bot token, scopes chat:write and im:history
SLACK_CONVERSATION=D0000000000    # the DM with the bot, or a channel it was invited to
SLACK_INCLUDE_ATTACHMENT=0        # 1 sends the verdict itself, not just its path
