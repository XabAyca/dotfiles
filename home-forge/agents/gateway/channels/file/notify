#!/usr/bin/env bash
# Appends the message to a local inbox. No network, no account: the channel
# left when the others are down.
set -euo pipefail

req=${1:?missing request}
STATE=${AGENT_GATEWAY_STATE:-$HOME/.local/state/agent-gateway}

jq -r --arg now "$(date '+%Y-%m-%d %H:%M')" '
  "\($now)  \(.target)  \(.step)  \(.title)"
  + (if .url != "" then "  " + .url else "" end)' "$req" >> "$STATE/inbox.md"
