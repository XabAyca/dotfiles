#!/usr/bin/env bash
# Reads the answer someone dropped in the file this request opened.
set -euo pipefail

req=${1:?missing request}
answer=$(jq -r '.handle // empty' "$req")
[ -n "$answer" ] && [ -s "$answer" ] || exit 0

# One line, trimmed. Anything else is a mistake, and the gateway will reject
# it against the options anyway.
head -1 "$answer" | tr -d '[:space:]'
rm -f "$answer"
