#!/usr/bin/env bash
# Posts one line saying a run wants looking at. The bot posts under its own
# name, which is what makes the message notify: Slack never notifies you of
# what you posted yourself. Nothing reads a reply; the answer is given on the
# machine.
set -euo pipefail

req=${1:?missing request}

SLACK_BOT_TOKEN=${SLACK_BOT_TOKEN:?set SLACK_BOT_TOKEN in config.env}
SLACK_CONVERSATION=${SLACK_CONVERSATION:?set SLACK_CONVERSATION in config.env}

case "$(jq -r '.kind' "$req")" in failure) icon=🚨 ;; done) icon=✅ ;; info) icon=📊 ;; *) icon=❓ ;; esac

text=$(jq -r --arg icon "$icon" '
  "\($icon) *\(.title)*"
  + (if .target != "" then " — `\(.target)` · étape `\(.step)`" else "" end) + "\n"
  + (if .url != "" then .url elif (.next // "") != "" then .next
     else "À voir sur la machine : `agent menu`" end)' "$req")

auth=$(mktemp); trap 'rm -f "$auth"' EXIT
# The token goes through a file: an argument is visible in `ps` to everything
# running on the machine.
printf 'Authorization: Bearer %s\n' "$SLACK_BOT_TOKEN" > "$auth"

ok=$(jq -n --arg c "$SLACK_CONVERSATION" --arg t "$text" '{channel: $c, text: $t}' \
  | curl -sS -X POST https://slack.com/api/chat.postMessage \
      -H "@$auth" -H 'Content-Type: application/json; charset=utf-8' \
      --data-binary @- \
  | jq -r 'if .ok then "ok" else "ERR:" + .error end')

case "$ok" in ok) ;; *) echo "slack notify: ${ok#ERR:}" >&2; exit 1 ;; esac
