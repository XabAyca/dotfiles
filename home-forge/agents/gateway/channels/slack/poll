#!/usr/bin/env bash
# Reads the thread the question opened and returns the last reply. A reply is
# trusted for nothing: the gateway checks it against the declared options.
set -euo pipefail

req=${1:?missing request}

SLACK_BOT_TOKEN=${SLACK_BOT_TOKEN:?set SLACK_BOT_TOKEN in config.env}
SLACK_CONVERSATION=${SLACK_CONVERSATION:?set SLACK_CONVERSATION in config.env}
ts=$(jq -r '.handle // empty' "$req")
[ -n "$ts" ] || exit 0

auth=$(mktemp); trap 'rm -f "$auth"' EXIT
printf 'Authorization: Bearer %s\n' "$SLACK_BOT_TOKEN" > "$auth"

reply=$(curl -sS -G https://slack.com/api/conversations.replies -H "@$auth" \
  --data-urlencode "channel=$SLACK_CONVERSATION" --data-urlencode "ts=$ts" \
  | jq -r --arg parent "$ts" '
      if .ok then [ .messages[] | select(.ts != $parent) ]
                  | (last // {}) | .text // "NONE"
      else "ERR:" + .error end')

case "$reply" in ERR:*) echo "slack poll: ${reply#ERR:}" >&2; exit 0 ;; esac

# Whitespace survives: an answer can be a sentence and not just a word.
word=$(printf %s "$reply" | tr -d '[:space:]')
[ "$word" = NONE ] && exit 0
[ -n "$word" ] || exit 0

printf %s "$reply"
