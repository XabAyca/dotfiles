#!/usr/bin/env bash
# Reads the thread the question opened and returns the first reply.
#
# A reply is trusted for nothing: the gateway checks it against the options
# the gate declared. Claude is a transport here, not a judge.
set -euo pipefail

req=${1:?missing request}

STATE=${AGENT_GATEWAY_STATE:-$HOME/.local/state/agent-gateway}
SLACK_CONVERSATION=${SLACK_CONVERSATION:?set SLACK_CONVERSATION in config.env}
TRUSTED=${AGENT_TRUSTED_DIR:-$HOME/projects/dotfiles/main}
# One model call per tick per waiting question adds up over a night; a
# question that waits an hour does not need sixty of them.
EVERY=${SLACK_POLL_EVERY:-300}

id=$(jq -r '.id' "$req")
ts=$(jq -r '.handle // empty' "$req")
[ -n "$ts" ] || exit 0

mkdir -p "$STATE/slack"
stamp="$STATE/slack/$id.lastpoll"
now=$(date +%s)
if [ -f "$stamp" ] && [ $(( now - $(cat "$stamp") )) -lt "$EVERY" ]; then
  exit 0
fi
echo "$now" > "$stamp"

# The prompt travels on stdin: --allowedTools takes a list, and a prompt
# passed as an argument after it is swallowed as one more tool name.
reply=$(cd "$TRUSTED" && printf %s \
  "Read the Slack thread whose parent message_ts is $ts in conversation $SLACK_CONVERSATION. If a reply to that parent exists, answer with the text of the most recent reply, verbatim, and nothing else — the thread may carry context posted by the machine itself, and only the last word counts. If there is no reply, answer exactly NONE. Never answer with the parent message itself." \
  | claude -p --allowedTools mcp__claude_ai_Slack__slack_read_thread \
      2>/dev/null | tr -d '[:space:]')

[ "$reply" = NONE ] && exit 0
[ -n "$reply" ] || exit 0

printf %s "$reply"
