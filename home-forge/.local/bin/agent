#!/usr/bin/env bash
# Runs a Spec Kit feature workflow on its own worktree, in a detached tmux
# session so `forge` can attach to it from the laptop.
set -euo pipefail

AGENTS=$HOME/agents/feature
PROJECTS=$HOME/projects
GATEWAY=$HOME/agents/gateway/gateway

. "$AGENTS/scripts/runner-paths.sh"

usage() {
  cat >&2 <<'USAGE'
usage:
  agent start <project> "<feature description>" [short-name]
  agent answer <project>/<branch> <run_id> [<input>=<value> ...]
  agent resume <project>/<branch> <run_id>
  agent retry <project>/<branch> <run_id> [step]   default: review-loop
  agent stop <project>/<branch>
  agent list
  agent menu                                      pick a run, then what to do with it
  agent preview <project>/<branch> <run_id>        what the menu shows in its pane
  agent done <project>/<branch>
USAGE
  exit 1
}

# A target is <project>/<branch>. Without the slash the expansions this replaces
# both yielded the whole string, and a git -C that fails inside $() reads as a
# clean worktree — so an invalid target used to pass every check.
tree_of() {
  case $1 in */*) ;; *) echo "target is <project>/<branch>, not '$1'" >&2; exit 1 ;; esac
  [ -d "$PROJECTS/$1" ] || { echo "no worktree at $PROJECTS/$1" >&2; exit 1; }
  printf '%s' "$PROJECTS/$1"
}

idle_or_die() {
  engine_pid "$1" >/dev/null || return 0
  echo "a run is still active in $1; agent stop first" >&2
  exit 1
}

engine_pid() {
  local tree=$1 pid
  tree=$(readlink -f "$tree")
  # The process name, not the command line: a command line matches any shell
  # that merely mentions the engine, a watcher of its own included.
  for pid in $(pgrep -x specify 2>/dev/null); do
    [ "$(readlink -f "/proc/$pid/cwd" 2>/dev/null)" = "$tree" ] && { echo "$pid"; return 0; }
  done
  return 1
}

# Detached, and never --json: that mode keeps stdout for its final object and
# `claude -p` prints nothing until a step ends, so the pane would look dead.
# The session ends on a shell, so it outlives the engine and can be read.
in_tmux() {
  local name=$1 dir=$2 cmd=$3
  tmux kill-session -t "$name" 2>/dev/null || true
  tmux new-session -d -s "$name" -c "$dir" \
    "SPECKIT_INTEGRATION_CLAUDE_EXTRA_ARGS='--permission-mode acceptEdits' \
     $cmd < /dev/null; exec $SHELL"
}

# Spec Kit slugs the description as it comes, so a French one names the branch
# and the worktree in French. Everything a machine carries stays English, and
# this is the only place that can decide it: the name is picked before any
# agent runs. Empty on any surprise — a slug from Spec Kit beats a start that
# fails on its naming call.
english_short_name() {
  claude -p --model haiku \
    "Answer with a 2-4 word English kebab-case slug for this feature, nothing else: $1" 2>/dev/null \
    | head -1 | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9-]/-/g; s/-\{2,\}/-/g; s/^-//; s/-$//' | cut -d- -f1-4 | cut -c1-40
}

start() {
  local project=${1:?missing project} description=${2:?missing description}
  local short=${3:-}
  local main="$PROJECTS/$project/main"
  [ -d "$main/.specify" ] || { echo "$project is not a Spec Kit project" >&2; exit 1; }

  # The PR will target the default branch, so the work starts from it and from
  # its current tip — not from whatever this checkout happens to have. Fetched
  # here and not later: the numbering below counts the remote branches too.
  local base
  base=$(cd "$main" && gh repo view --json defaultBranchRef -q .defaultBranchRef.name)
  git -C "$main" fetch --quiet origin "$base"

  # Spec Kit numbers from the specs/ of this checkout, which knows nothing of
  # features still on unmerged branches. Count the branches too, or two
  # features started in parallel claim the same number.
  local numbering number_arg=()
  numbering=$(jq -r '.feature_numbering // "sequential"' "$main/.specify/init-options.json")
  if [ "$numbering" = timestamp ]; then
    number_arg=(--timestamp)
  elif [ "$numbering" = sequential ]; then
    local highest next
    highest=$( { ls "$main/specs" 2>/dev/null
                 git -C "$main" branch -a --format='%(refname:short)'; } \
               | grep -oE '^[0-9]{3}' | sort -n | tail -1)
    next=$(( 10#${highest:-0} + 1 ))
    number_arg=(--number "$next")
  fi
  [ -n "$short" ] || short=$(english_short_name "$description")
  [ -n "$short" ] && number_arg+=(--short-name "$short")

  # Ask for the name Spec Kit will pick, so worktree, branch and specs agree.
  local branch
  branch=$(cd "$main" && bash .specify/scripts/bash/create-new-feature.sh \
    --dry-run --json "${number_arg[@]}" "$description" | jq -re '.BRANCH_NAME')

  local tree="$PROJECTS/$project/$branch"
  [ -e "$tree" ] && { echo "$tree already exists" >&2; exit 1; }

  git -C "$main" worktree add "$tree" -b "$branch" "origin/$base"

  # The installed workflow is not committed, so each worktree gets its own copy.
  (cd "$tree" && specify workflow add --dev "$AGENTS" >/dev/null)

  # Project agent config may not be committed yet; copy it rather than miss it.
  local f
  for f in "$main"/.specify/agents-*; do
    [ -e "$f" ] && cp "$f" "$tree/.specify/"
  done

  # A fresh worktree lacks everything the project gitignores.
  if [ -x "$tree/.specify/agents-bootstrap.sh" ]; then
    echo "bootstrap  running .specify/agents-bootstrap.sh"
    (cd "$tree" && ./.specify/agents-bootstrap.sh)
  fi

  in_tmux "$project/$branch" "$tree" \
    "specify workflow run feature -i spec=$(printf %q "$description")"

  echo "worktree  $tree"
  echo "branch    $branch"
  echo "session   $project/$branch   (forge, or tmux attach -t '$project/$branch')"
}

answer() {
  local target=${1:?missing project/branch} run_id=${2:?missing run_id}
  shift 2
  [ $# -gt 0 ] || usage
  local tree; tree=$(tree_of "$target")
  idle_or_die "$tree"
  local args=""
  local kv
  for kv in "$@"; do args="$args --input $kv"; done
  # Detached: answering a gate must not hold the caller for the whole run.
  in_tmux "$target" "$tree" "specify workflow resume $run_id$args"
  echo "answered  $run_id$args"
}

resume() {
  local target=${1:?missing project/branch} run_id=${2:?missing run_id}
  local tree; tree=$(tree_of "$target")
  idle_or_die "$tree"
  local state="$tree/.specify/workflows/runs/$run_id/state.json"

  # A run killed without a signal never recorded its end: it stays "running",
  # which the engine refuses to resume although the work is all on disk.
  if [ -f "$state" ] && [ "$(jq -r '.status' "$state")" = running ] \
     && ! engine_pid "$tree" >/dev/null; then
    local tmp; tmp=$(mktemp)
    jq '.status = "failed"
        | .error = "engine stopped without recording its state"
        | if .current_step_id and .step_results[.current_step_id]
          then .step_results[.current_step_id].status = "failed" else . end' \
      "$state" > "$tmp" && mv "$tmp" "$state"
    echo "repaired  stale running state for $run_id"
  fi

  in_tmux "$target" "$tree" "specify workflow resume $run_id"
  echo "resumed   $run_id in session $target"
}

# The engine rewrites the workflow when it freezes a run, so a top-level
# step is not at the indentation the source has. Read it from the file.
top_steps() {
  local pad
  pad=$(awk '/^steps:/{f=1; next} f && /- id: /{match($0, /^ */); print substr($0, 1, RLENGTH); exit}' "$1")
  grep "^${pad}- id: " "$1" | sed 's/.*- id: //'
}

retry() {
  local target=${1:?missing project/branch} run_id=${2:?missing run_id}
  local step=${3:-review-loop}
  local tree; tree=$(tree_of "$target")
  local dir="$tree/.specify/workflows/runs/$run_id"
  [ -f "$dir/state.json" ] || { echo "no such run: $run_id" >&2; exit 1; }
  # ponytail: this rewrites the engine's own state. Fail loudly if the fields
  # it depends on ever move, rather than corrupt a run in silence.
  jq -e 'has("status") and has("current_step_index") and has("current_step_id")' \
     "$dir/state.json" >/dev/null || {
    echo "state.json no longer has the fields retry rewrites; check the Spec Kit version" >&2
    exit 1; }
  idle_or_die "$tree"

  # The verdicts go with the rewind, so the next pass judges what now stands,
  # and the written answers with them: a gate reached again reads its own file
  # before anyone has replied, and would apply the last run's answer in silence.
  rm -f "$tree/.specify/state/$run_id/review.json" \
        "$tree/.specify/state/$run_id/ui.json" \
        "$tree/.specify/state/$run_id/attempts" \
        "$tree/.specify/state/$run_id/ship.md" \
        "$tree/.specify/state/$run_id"/*-answer.md

  # A verdict_input holds its answer for the whole run and decides its gate
  # without asking again, so a rewind that kept them would replay old
  # decisions in silence. Only the gates from the rewind point are cleared.
  local names tmp2
  names=$(awk -v step="$step" '
      $0 ~ "^[[:space:]]*-[[:space:]]*id:[[:space:]]*" step "[[:space:]]*$" { from = 1 }
      from && /verdict_input:/ { sub(/.*verdict_input:[[:space:]]*/, ""); print }
    ' "$dir/workflow.yml" | sort -u)
  if [ -n "$names" ]; then
    tmp2=$(mktemp)
    jq --arg n "$names" \
       'reduce ($n | split("\n")[]) as $k (.; .inputs[$k] = "")' \
       "$dir/inputs.json" > "$tmp2" && mv "$tmp2" "$dir/inputs.json"
    echo "cleared   $(echo "$names" | tr '\n' ' ')"
  fi

  local idx tmp
  idx=$(top_steps "$dir/workflow.yml" | grep -nx -- "$step" | cut -d: -f1)
  [ -n "$idx" ] || { echo "no top-level step '$step' in this workflow" >&2; exit 1; }

  tmp=$(mktemp)
  jq --argjson i "$((idx - 1))" \
     --arg s "$step" \
     '.status = "failed" | .current_step_index = $i | .current_step_id = $s' \
     "$dir/state.json" > "$tmp" && mv "$tmp" "$dir/state.json"

  echo "rewound   $run_id to $step"
  in_tmux "$target" "$tree" "specify workflow resume $run_id"
}

stop() {
  local target=${1:?missing project/branch}
  local tree; tree=$(tree_of "$target")
  local pid
  if pid=$(engine_pid "$tree"); then
    # SIGINT is what the engine listens for: it records why it stopped, which
    # is the difference between a resumable run and a lost one.
    kill -INT "$pid"
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do sleep 1; i=$((i + 1)); done
    kill -0 "$pid" 2>/dev/null && echo "warning: engine $pid still alive after 30s" >&2
  fi
  tmux kill-session -t "$target" 2>/dev/null || true
  echo "stopped   $target"
}

# One tab-separated row per run: target, run, status, step, idle. The menu
# reads the same rows as the listing, so both always say the same thing.
rows() {
  local tree
  for tree in "$PROJECTS"/*/*/; do
    [ -d "$tree/.specify/workflows/runs" ] || continue
    local f
    for f in "$tree"/.specify/workflows/runs/*/state.json; do
      [ -f "$f" ] || continue
      # Without the idle time a working run and a stuck one look alike:
      # `claude -p` prints nothing until its step finishes.
      jq -r --arg t "$(basename "$(dirname "$tree")")/$(basename "$tree")" \
         --argjson now "$(date +%s)" \
        '[$t, .run_id, .status, (.current_step_id // "-"),
          ((($now - (.updated_at | sub("\\.[0-9]+"; "") | sub("\\+00:00"; "Z") | fromdateiso8601)) / 60
            | floor | tostring) + " min")] | @tsv' "$f"
    done
  done
}

list() { rows | column -t -s "$(printf '\t')"; }

# What the menu shows beside the list: where the run stands, the question it is
# waiting on, and the tail of its pane — the only place a working step speaks.
preview() {
  local target=${1:?missing project/branch} run=${2:?missing run_id}
  local state="$PROJECTS/$target/.specify/workflows/runs/$run/state.json"
  [ -f "$state" ] || { echo "no such run"; return 0; }
  jq -r '"status  " + .status,
         "step    " + (.current_step_id // "-"),
         "since   " + .updated_at,
         "",
         (.error // empty),
         (.step_results[.current_step_id].output.message // empty)' "$state"
  echo
  tmux capture-pane -pt "$target" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -20
}

# Pick a run, then what to do with it. The actions are the subcommands above,
# offered only where the status allows them — an answer to a run that is not
# waiting, or a worktree removed under a live engine, are the two mistakes
# this is here to make impossible.
menu() {
  command -v fzf >/dev/null || { echo "agent menu needs fzf" >&2; exit 1; }
  local all sel target run status step
  all=$(rows)
  [ -n "$all" ] || { echo "no run on this machine"; return 0; }

  sel=$(printf '%s\n' "$all" | column -t -s "$(printf '\t')" \
    | fzf --prompt='< runs > ' --height=60% --reverse --no-sort \
          --preview "$0 preview {1} {2}" --preview-window=right,55%) || return 0
  [ -n "$sel" ] || return 0
  read -r target run status step _ <<< "$sel"

  local actions
  case $status in
    paused)  actions=$'answer approve\nanswer reject\nanswer in plain text\nretry\nattach\nstop' ;;
    running) actions=$'attach\nstop' ;;
    failed)  actions=$'resume\nretry\nattach\nstop' ;;
    *)       actions=$'attach\nretry\nrecord\ndone' ;;
  esac

  local action
  action=$(printf '%s\n' "$actions" \
    | fzf --prompt="< $target  $step > " --height=40% --reverse --no-sort) || return 0

  case $action in
    'answer approve')       "$GATEWAY" reply "$target" "$run" approve ;;
    'answer reject')        "$GATEWAY" reply "$target" "$run" reject ;;
    'answer in plain text')
      local text
      read -r -p 'answer: ' text
      if [ -n "$text" ]; then "$GATEWAY" reply "$target" "$run" "$text"; fi ;;
    attach)
      # Nesting a session inside another is refused; from a pane, move to it.
      if [ -n "${TMUX:-}" ]; then tmux switch-client -t "$target"
      else exec tmux new-session -A -s "$target" -c "$PROJECTS/$target"; fi ;;
    stop)   stop "$target" ;;
    resume) resume "$target" "$run" ;;
    retry)
      local steps from
      steps=$(top_steps "$PROJECTS/$target/.specify/workflows/runs/$run/workflow.yml")
      from=$(printf '%s\n' "$steps" \
        | fzf --prompt="< retry $target from > " --height=40% --reverse --no-sort \
              --bind "start:pos($(printf '%s\n' "$steps" | grep -nx review-loop | cut -d: -f1))") \
        || return 0
      retry "$target" "$run" "$from" ;;
    record) record show "$run" ;;
    done)   done_ "$target" ;;
  esac
}

done_() {
  local target=${1:?missing project/branch}
  local tree; tree=$(tree_of "$target")
  idle_or_die "$tree"
  # The runner's own footprint is never committed, so it is not work.
  [ -z "$(git -C "$tree" status --porcelain -- "${RUNNER_EXCLUDE[@]}")" ] || {
    echo "$tree has uncommitted changes" >&2; exit 1; }
  # Last chance: what the runs cost goes away with the worktree otherwise.
  record run "$target"
  # Forced only because the check above already passed: git refuses a worktree
  # holding anything at all, and what is left is the runner's own footprint.
  git -C "$PROJECTS/${target%%/*}/main" worktree remove --force "$tree"
  # The session's working directory has just gone; it would only survive to
  # confuse the next listing.
  tmux kill-session -t "$target" 2>/dev/null || true
  echo "removed $tree"
}

# Sourced by the test to reach the functions above; a run never sets it.
[ "${AGENT_LIB:-}" = 1 ] && return 0

case ${1:-} in
  start)  shift; start "$@" ;;
  resume) shift; resume "$@" ;;
  retry)  shift; retry "$@" ;;
  stop)   shift; stop "$@" ;;
  answer) shift; answer "$@" ;;
  list)   shift; list ;;
  menu)   shift; menu ;;
  preview) shift; preview "$@" ;;
  done)   shift; done_ "$@" ;;
  *)      usage ;;
esac
